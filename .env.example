# Supabase Postgres (Prisma 7)
DATABASE_URL=
DIRECT_URL=

# Authentication (own sessions, no third-party auth service)
# Random secret, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Brevo (https://app.brevo.com): SMTP & API -> API keys. The sender address must be verified in Brevo (Senders & IP).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MoleSkill

# Google sign-in (optional; the button is hidden while these are empty).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: NEXT_PUBLIC_SITE_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage: project URL, publishable/anon key, service role key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deepgram speech-to-text (required for audio processing)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Use multi for Russian/English switching, or a single language such as ru.
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_TIMEOUT_MS=600000

# Язык распознавания голоса ассистента. Пусто = язык интерфейса (ru или en).
ASSISTANT_STT_LANGUAGE=

# Groq is used only for LLM analysis, questions and translation
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Optional scheduled retries for stuck meetings
CRON_SECRET=

# Public app settings
NEXT_PUBLIC_SITE_URL=https://moleskill.com
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_DONATION_URL=
DELETE_AUDIO_DEFAULT=false
